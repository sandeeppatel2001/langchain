{
   "openapi": "3.0.0",
   "info": {
      "title": "QuickChart API",
      "version": "1.0.0",
      "description": "An API to generate charts and QR codes using QuickChart services."
   },
   "servers": [
      {
         "url": "https://quickchart.io"
      }
   ],
   "components": {
      "securitySchemes": {
         "bearerAuth": {
            "type": "http",
            "scheme": "bearer"
         }
      }
   },
   "security": [
      {
         "bearerAuth": []
      }
   ],
   "paths": {
      "/chart": {
         "get": {
            "summary": "Generate a chart (GET)",
            "description": "Generate a chart based on the provided parameters.",
            "parameters": [
               {
                  "in": "query",
                  "name": "chart",
                  "schema": {
                     "type": "string",
                     "pattern": ".+",
                     "maxLength": 65536
                  },
                  "description": "The chart configuration in Chart.js format (JSON or Javascript)."
               },
               {
                  "in": "query",
                  "name": "width",
                  "schema": {
                     "type": "integer",
                     "minimum": 0
                  },
                  "description": "The width of the chart in pixels."
               },
               {
                  "in": "query",
                  "name": "height",
                  "schema": {
                     "type": "integer",
                     "minimum": 0
                  },
                  "description": "The height of the chart in pixels."
               },
               {
                  "in": "query",
                  "name": "format",
                  "schema": {
                     "type": "string",
                     "pattern": "^(png|jpg|svg|webp)$",
                     "maxLength": 5
                  },
                  "description": "The output format of the chart, e.g., 'png', 'jpg', 'svg', or 'webp'."
               },
               {
                  "in": "query",
                  "name": "backgroundColor",
                  "schema": {
                     "type": "string",
                     "pattern": "^#[0-9a-fA-F]{6}$",
                     "maxLength": 7
                  },
                  "description": "The background color of the chart."
               }
            ],
            "responses": {
               "200": {
                  "description": "A generated chart image.",
                  "content": {
                     "image/png": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/jpeg": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/svg+xml": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/webp": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     }
                  }
               },
               "400": {
                  "description": "Bad Request"
               },
               "401": {
                  "description": "Unauthorized"
               },
               "403": {
                  "description": "Forbidden"
               },
               "404": {
                  "description": "Not Found"
               },
               "429": {
                  "description": "Too Many Requests"
               },
               "500": {
                  "description": "Internal Server Error"
               },
               "default": {
                  "description": "Unexpected error"
               }
            }
         },
         "post": {
            "summary": "Generate a chart (POST)",
            "description": "Generate a chart based on the provided configuration in the request body.",
            "requestBody": {
               "required": true,
               "content": {
                  "application/json": {
                     "schema": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                           "chart": {
                              "type": "object",
                              "description": "The chart configuration in JSON format."
                           },
                           "width": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "The width of the chart in pixels."
                           },
                           "height": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "The height of the chart in pixels."
                           },
                           "format": {
                              "type": "string",
                              "pattern": "^(png|jpg|svg|webp)$",
                              "maxLength": 5,
                              "description": "The output format of the chart, e.g., 'png', 'jpg', 'svg', or 'webp'."
                           },
                           "backgroundColor": {
                              "type": "string",
                              "pattern": "^#[0-9a-fA-F]{6}$",
                              "maxLength": 7,
                              "description": "The background color of the chart."
                           }
                        }
                     }
                  }
               }
            },
            "responses": {
               "200": {
                  "description": "A generated chart image.",
                  "content": {
                     "image/png": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/jpeg": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/svg+xml": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/webp": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     }
                  }
               },
               "400": {
                  "description": "Bad Request"
               },
               "401": {
                  "description": "Unauthorized"
               },
               "403": {
                  "description": "Forbidden"
               },
               "415": {
                  "description": "Unsupported Media Type"
               },
               "429": {
                  "description": "Too Many Requests"
               },
               "500": {
                  "description": "Internal Server Error"
               },
               "default": {
                  "description": "Unexpected error"
               }
            }
         }
      },
      "/qr": {
         "get": {
            "summary": "Generate a QR code (GET)",
            "description": "Generate a QR code based on the provided parameters.",
            "parameters": [
               {
                  "in": "query",
                  "name": "text",
                  "schema": {
                     "type": "string",
                     "pattern": ".+",
                     "maxLength": 4096
                  },
                  "description": "The text to be encoded in the QR code."
               },
               {
                  "in": "query",
                  "name": "width",
                  "schema": {
                     "type": "integer",
                     "minimum": 0
                  },
                  "description": "The width of the QR code in pixels."
               },
               {
                  "in": "query",
                  "name": "height",
                  "schema": {
                     "type": "integer",
                     "minimum": 0
                  },
                  "description": "The height of the QR code in pixels."
               },
               {
                  "in": "query",
                  "name": "format",
                  "schema": {
                     "type": "string",
                     "pattern": "^(png|svg)$",
                     "maxLength": 4
                  },
                  "description": "The output format of the QR code, e.g., 'png' or 'svg'."
               },
               {
                  "in": "query",
                  "name": "margin",
                  "schema": {
                     "type": "integer",
                     "minimum": 0
                  },
                  "description": "The margin around the QR code in pixels."
               }
            ],
            "responses": {
               "200": {
                  "description": "A generated QR code image.",
                  "content": {
                     "image/png": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/svg+xml": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     }
                  }
               },
               "400": {
                  "description": "Bad Request"
               },
               "401": {
                  "description": "Unauthorized"
               },
               "403": {
                  "description": "Forbidden"
               },
               "404": {
                  "description": "Not Found"
               },
               "429": {
                  "description": "Too Many Requests"
               },
               "500": {
                  "description": "Internal Server Error"
               },
               "default": {
                  "description": "Unexpected error"
               }
            }
         },
         "post": {
            "summary": "Generate a QR code (POST)",
            "description": "Generate a QR code based on the provided configuration in the request body.",
            "requestBody": {
               "required": true,
               "content": {
                  "application/json": {
                     "schema": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                           "text": {
                              "type": "string",
                              "pattern": ".+",
                              "maxLength": 4096,
                              "description": "The text to be encoded in the QR code."
                           },
                           "width": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "The width of the QR code in pixels."
                           },
                           "height": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "The height of the QR code in pixels."
                           },
                           "format": {
                              "type": "string",
                              "pattern": "^(png|svg)$",
                              "maxLength": 4,
                              "description": "The output format of the QR code, e.g., 'png' or 'svg'."
                           },
                           "margin": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "The margin around the QR code in pixels."
                           }
                        }
                     }
                  }
               }
            },
            "responses": {
               "200": {
                  "description": "A generated QR code image.",
                  "content": {
                     "image/png": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     },
                     "image/svg+xml": {
                        "schema": {
                           "type": "string",
                           "format": "binary",
                           "pattern": ".+",
                           "maxLength": 10485760
                        }
                     }
                  }
               },
               "400": {
                  "description": "Bad Request"
               },
               "401": {
                  "description": "Unauthorized"
               },
               "403": {
                  "description": "Forbidden"
               },
               "415": {
                  "description": "Unsupported Media Type"
               },
               "429": {
                  "description": "Too Many Requests"
               },
               "500": {
                  "description": "Internal Server Error"
               },
               "default": {
                  "description": "Unexpected error"
               }
            }
         }
      }
   }
}
