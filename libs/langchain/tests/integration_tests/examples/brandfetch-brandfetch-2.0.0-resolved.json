{
  "openapi": "3.0.1",
  "info": {
    "title": "Brandfetch API",
    "description": "Brandfetch API (v2) for retrieving brand information.\n\nSee our [documentation](https://docs.brandfetch.com/) for further details.                   ",
    "termsOfService": "https://brandfetch.com/terms",
    "contact": {
      "url": "https://brandfetch.com/developers"
    },
    "version": "2.0.0"
  },
  "externalDocs": {
    "description": "Documentation",
    "url": "https://docs.brandfetch.com/"
  },
  "servers": [
    {
      "url": "https://api.brandfetch.io/v2"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/brands/{domainOrId}": {
      "get": {
        "summary": "Retrieve a brand",
        "description": "Fetch brand information by domain or ID\n\nFurther details here: https://docs.brandfetch.com/reference/retrieve-brand\n",
        "parameters": [
          {
            "name": "domainOrId",
            "in": "path",
            "description": "Domain or ID of the brand",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9.-]+$",
              "maxLength": 253
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Brand data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Brand"
                },
                "examples": {
                  "brandfetch.com": {
                    "value": {
                      "name": "Brandfetch",
                      "domain": "brandfetch.com",
                      "claimed": true,
                      "description": "All brands. In one place",
                      "links": [
                        {"name": "twitter", "url": "https://twitter.com/brandfetch"},
                        {"name": "linkedin", "url": "https://linkedin.com/company/brandfetch"}
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid domain or ID supplied"
          },
          "404": {
            "description": "The brand does not exist or the domain can't be resolved."
          },
          "500": {
            "description": "Internal Server Error"
          },
          "default": {
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Brand": {
        "required": [
          "claimed",
          "colors",
          "description",
          "domain",
          "fonts",
          "images",
          "links",
          "logos",
          "name"
        ],
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageAsset"
            },
            "maxItems": 50
          },
          "fonts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FontAsset"
            },
            "maxItems": 50
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}$",
            "maxLength": 253
          },
          "claimed": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "pattern": "^.{1,100}$",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "pattern": "^.{0,1000}$",
            "maxLength": 1000
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Brand_links"
            },
            "maxItems": 50
          },
          "logos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageAsset"
            },
            "maxItems": 50
          },
          "colors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColorAsset"
            },
            "maxItems": 50
          }
        },
        "description": "Object representing a brand",
        "additionalProperties": false
      },
      "ColorAsset": {
        "required": [
          "brightness",
          "hex",
          "type"
        ],
        "type": "object",
        "properties": {
          "brightness": {
            "type": "integer",
            "minimum": 0
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "maxLength": 7
          },
          "type": {
            "type": "string",
            "enum": [
              "accent",
              "brand",
              "customizable",
              "dark",
              "light",
              "vibrant"
            ]
          }
        },
        "description": "Brand color asset",
        "additionalProperties": false
      },
      "FontAsset": {
        "type": "object",
        "properties": {
          "originId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 128
          },
          "origin": {
            "type": "string",
            "enum": [
              "adobe",
              "custom",
              "google",
              "system"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^.{1,128}$",
            "maxLength": 128
          },
          "type": {
            "type": "string",
            "pattern": "^.{1,128}$",
            "maxLength": 128
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "maxItems": 50
          },
          "items": {
            "type": "string",
            "pattern": "^.{0,1000}$",
            "maxLength": 1000
          }
        },
        "description": "Brand font asset",
        "additionalProperties": false
      },
      "ImageAsset": {
        "required": [
          "formats",
          "theme",
          "type"
        ],
        "type": "object",
        "properties": {
          "formats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageFormat"
            },
            "maxItems": 50
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "logo",
              "icon",
              "symbol",
              "banner"
            ]
          }
        },
        "description": "Brand image asset",
        "additionalProperties": false
      },
      "ImageFormat": {
        "required": [
          "background",
          "format",
          "size",
          "src"
        ],
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "src": {
            "type": "string",
            "pattern": "^https?://\\S+$",
            "maxLength": 2048
          },
          "background": {
            "type": "string",
            "enum": [
              "transparent"
            ]
          },
          "format": {
            "type": "string",
            "pattern": "^[a-z0-9]+$",
            "maxLength": 10
          },
          "width": {
            "type": "integer",
            "minimum": 0
          },
          "height": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": "Brand image asset image format",
        "additionalProperties": false
      },
      "Brand_links": {
        "required": [
          "name",
          "url"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^.{1,100}$",
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$",
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key"
      }
    }
  }
}
